    "def fit_nn_regressor(X: np.ndarray, y: np.ndarray, seed: int) -> Pipeline:\n",
    "    \"\"\"One hidden layer; deliberately small for the sparse capstone data.\"\"\"\n",
    "    model = Pipeline(\n",
    "        [\n",
    "            (\"scale\", StandardScaler()),\n",
    "            (\n",
    "                \"model\",\n",
    "                MLPRegressor(\n",