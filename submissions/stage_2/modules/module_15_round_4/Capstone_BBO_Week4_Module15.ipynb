    "## Progression through the completed rounds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cbf6bcfe",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-14T17:50:21.380322Z",
     "iopub.status.busy": "2026-08-14T17:50:21.380009Z",
     "iopub.status.idle": "2026-08-14T17:50:21.390442Z",
     "shell.execute_reply": "2026-08-14T17:50:21.389510Z"
    }
   },
   "outputs": [],
   "source": [
    "progress_rows = []\n",
    "for fn in range(1, 9):\n",
    "    X0, y0 = load_initial(fn)\n",
    "    running_best = float(np.max(y0))\n",
    "    initial_best = running_best\n",
    "    row = {\n",
    "        \"Function\": fn,\n",
    "        \"Dimensions\": X0.shape[1],\n",
    "        \"Initial n\": len(y0),\n",
    "        \"Initial best\": initial_best,\n",
    "    }\n",
    "    for r in range(3):\n",
    "        value = float(ROUND_OUTPUTS[r][fn - 1])\n",
    "        row[f\"Round {r+1} output\"] = value\n",
    "        row[f\"Round {r+1} new best\"] = value > running_best\n",
    "        running_best = max(running_best, value)\n",
    "    row[\"Best after Round 3\"] = running_best\n",
    "    progress_rows.append(row)\n",
    "\n",
    "progress_df = pd.DataFrame(progress_rows)\n",
    "progress_df.to_csv(RESULTS_DIR / \"progression_summary.csv\", index=False)"
   ]
  },
